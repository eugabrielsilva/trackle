<?php

require_once __DIR__ . '/../functions/database.php';
require_once __DIR__ . '/../functions/curl.php';

$id = $argv[1] ?? null;

$url_playlist = 'https://api.deezer.com/playlist/';

$db = db_connect();

if (!empty($id)) {
    echo 'Adicionando playlist: ' . $id;

    // Obter playlist
    $data = curl_get($url_playlist . $id);

    if (empty($data) || !empty($data['error'])) {
        echo ' - ERRO AO BUSCAR NA API' . PHP_EOL;
        exit;
    }

    // Cria a playlist
    db_query($db, 'INSERT INTO playlists (name, deezer_id, picture_url) VALUES (:name, :deezer_id, :picture_url)', [
        ':name' => $data['title'],
        ':deezer_id' => $data['id'],
        ':picture_url' => $data['picture_big'],
    ]);

    // Obter playlist
    $playlist = db_query($db, 'SELECT * FROM playlists WHERE deezer_id = :deezer_id', [
        ':deezer_id' => $data['id'],
    ])[0] ?? null;

    if (empty($playlist)) {
        echo ' - ERRO AO OBTER PLAYLIST' . PHP_EOL;
        exit;
    }

    // Atualiza as músicas da playlist
    foreach ($data['tracks']['data'] as $track) {
        if (empty($track['preview'])) {
            continue;
        }

        $song = db_query($db, 'SELECT * FROM songs WHERE deezer_id = :deezer_id AND playlist_id = :playlist_id', [
            ':deezer_id' => $track['id'],
            ':playlist_id' => $playlist['id'],
        ]);

        // Atualiza ou cria a música
        if (!empty($song[0])) {
            db_query($db, 'UPDATE songs SET name = :name, artist = :artist, picture_url = :picture_url WHERE id = :id', [
                ':id' => $song[0]['id'],
                ':name' => $track['title'],
                ':artist' => $track['artist']['name'],
                ':picture_url' => $track['album']['cover_big'],
            ]);
        } else {
            db_query($db, 'INSERT INTO songs (name, artist, playlist_id, deezer_id, picture_url) VALUES (:name, :artist, :playlist_id, :deezer_id, :picture_url)', [
                ':name' => $track['title'],
                ':artist' => $track['artist']['name'],
                ':playlist_id' => $playlist['id'],
                ':deezer_id' => $track['id'],
                ':picture_url' => $track['album']['cover_big'],
            ]);
        }
    }

    echo ' - OK' . PHP_EOL;
} else {
    echo 'ID da playlist não informado' . PHP_EOL;
}
