<?php

require_once __DIR__ . '/../functions/database.php';
require_once __DIR__ . '/../functions/curl.php';

$id = $argv[1] ?? null;

$url_playlist = 'https://api.deezer.com/playlist/';

if (!empty($id)) {
    // Obter playlist
    $playlist = db_query($db, 'SELECT * FROM playlists WHERE deezer_id = :deezer_id', [
        ':deezer_id' => $id,
    ])[0] ?? null;

    if (empty($playlist)) {
        echo 'Playlist não encontrada no banco de dados' . PHP_EOL;
        exit;
    }

    updatePlaylist($playlist, $url_playlist, $db);
} else {
    // Obter todas as playlists
    $playlists = db_query($db, 'SELECT * FROM playlists');

    foreach ($playlists as $playlist) {
        updatePlaylist($playlist, $url_playlist, $db);
    }
}

function updatePlaylist($playlist, $url_playlist, $db)
{
    echo 'Atualizando playlist: ' . $playlist['name'];

    // Obter playlist
    $data = curl_get($url_playlist . $playlist['deezer_id']);

    if (empty($data) || !empty($data['error'])) {
        echo ' - ERRO AO BUSCAR NA API' . PHP_EOL;
        exit;
    }

    // Atualiza a playlist
    db_query($db, 'UPDATE playlists SET name = :name, slug = :slug, picture_url = :picture_url WHERE id = :id', [
        ':id' => $playlist['id'],
        ':name' => $data['title'],
        ':slug' => slug($data['title']),
        ':picture_url' => $data['picture_big'],
    ]);

    // Atualiza as músicas da playlist
    $track_ids = [];

    foreach ($data['tracks']['data'] as $track) {
        if (empty($track['preview'])) {
            continue;
        }

        $song = db_query($db, 'SELECT * FROM songs WHERE deezer_id = :deezer_id AND playlist_id = :playlist_id', [
            ':deezer_id' => $track['id'],
            ':playlist_id' => $playlist['id'],
        ]);

        // Atualiza ou cria a música
        if (!empty($song[0])) {
            db_query($db, 'UPDATE songs SET name = :name, artist = :artist, picture_url = :picture_url, album = :album WHERE id = :id', [
                ':id' => $song[0]['id'],
                ':name' => $track['title_short'] ?? $track['title'],
                ':artist' => $track['artist']['name'],
                ':picture_url' => $track['album']['cover_big'],
                ':album' => $track['album']['title'] ?? '',
            ]);
        } else {
            db_query($db, 'INSERT INTO songs (name, artist, playlist_id, deezer_id, picture_url, album) VALUES (:name, :artist, :playlist_id, :deezer_id, :picture_url, :album)', [
                ':name' => $track['title_short'] ?? $track['title'],
                ':artist' => $track['artist']['name'],
                ':playlist_id' => $playlist['id'],
                ':deezer_id' => $track['id'],
                ':picture_url' => $track['album']['cover_big'],
                ':album' => $track['album']['title'] ?? '',
            ]);
        }

        $track_ids[] = $track['id'];
    }

    // Remove músicas que não estão na playlist
    if (!empty($track_ids)) {
        $placeholders = implode(',', array_fill(0, count($track_ids), '?'));
        $sql = "DELETE FROM songs WHERE playlist_id = ? AND deezer_id NOT IN ($placeholders)";
        $params = array_merge([$playlist['id']], $track_ids);
        db_query($db, $sql, $params);
    }

    echo ' - OK' . PHP_EOL;
}
